TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1626702040}
  m_Text: '1 1/4 cups all-purpose flour

    1 1/4 teaspoons baking powder

    1/4
    teaspoon salt

    6 tbsp softened butter (84 g)

    3/4 cup granulated sugar

    2
    tbsp vegetable oil

    1 1/2 teaspoons vanilla extract

    2 large eggs

    1/2
    cup + 2 tbsp milk


    Preheat 180 C; line 12 wells

    Make batter; fill 3/4;
    bake

    Test centre; cool on wire rack


    From-scratch frosting: next'
